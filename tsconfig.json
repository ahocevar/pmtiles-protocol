{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "module": "ES2022",
    "target": "es2022",
    "lib": ["dom", "es2022"],
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "."
  },
  "include": ["index.js"],
  "exclude": ["node_modules", "**/*.d.ts"]
}
